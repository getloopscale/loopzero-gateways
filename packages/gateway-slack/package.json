{
  "name": "@getloopscale/loopzero-gateway-slack",
  "version": "0.2.0",
  "description": "Slack (@slack/bolt) platform adapter for @getloopscale/loopzero-gateway. ADRs D267-D285.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@slack/bolt": "^4.0.0 || ^5.0.0",
    "@getloopscale/loopzero-gateway": ">=0.6.0 <1.0.0",
    "@getloopscale/loopzero-sdk": "^2.18.0"
  },
  "devDependencies": {
    "@slack/bolt": "^4.6.0",
    "@getloopscale/loopzero-gateway": "workspace:*",
    "@getloopscale/loopzero-sdk": "^2.18.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

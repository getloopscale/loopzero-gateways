{
  "name": "@getloopscale/loopzero-gateway-mattermost",
  "version": "0.4.1",
  "description": "Mattermost platform adapter for @getloopscale/loopzero-gateway. WebSocket gateway + REST. ADRs D397-D404.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loopzero-gateways.git",
    "directory": "packages/gateway-mattermost"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@mattermost/client": "^9.0.0 || ^11.0.0",
    "@getloopscale/loopzero-gateway": ">=0.21.0 <1.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@mattermost/client": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mattermost/client": "11.9.0",
    "@stryker-mutator/core": "10",
    "@stryker-mutator/vitest-runner": "10",
    "@getloopscale/loopzero-gateway": "workspace:*",
    "@getloopscale/loopzero-sdk": "^4.62.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/getloopscale/loopzero-gateways/issues"
  },
  "homepage": "https://github.com/getloopscale/loopzero-gateways/tree/main/packages/gateway-mattermost#readme",
  "keywords": [
    "loopzero",
    "gateway",
    "mattermost",
    "platform",
    "adapter",
    "websocket",
    "rest",
    "adrs"
  ]
}

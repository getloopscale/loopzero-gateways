{
  "name": "@getloopscale/loopzero-gateway-agent",
  "version": "0.2.0",
  "description": "Agent bridge for @getloopscale/loopzero-gateway: run a LoopZero SDK agent turn to text and deliver text to a channel rendered for its platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loopzero-gateways.git",
    "directory": "packages/gateway-agent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@getloopscale/loopzero-gateway": ">=0.20.0 <1.0.0",
    "@getloopscale/loopzero-presenter": ">=0.10.0 <1.0.0",
    "@getloopscale/loopzero-sdk": ">=2.18.0 <6"
  },
  "devDependencies": {
    "@getloopscale/loopzero-agents": "16.5.0",
    "@getloopscale/loopzero-gateway": "workspace:*",
    "@getloopscale/loopzero-presenter": "^0.10.0",
    "@getloopscale/loopzero-sdk": "^5.9.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/getloopscale/loopzero-gateways/issues"
  },
  "homepage": "https://github.com/getloopscale/loopzero-gateways/tree/main/packages/gateway-agent#readme",
  "keywords": [
    "loopzero",
    "gateway",
    "agent",
    "sdk",
    "presenter"
  ]
}

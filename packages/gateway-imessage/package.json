{
  "name": "@getloopscale/loopzero-gateway-imessage",
  "version": "0.3.1",
  "description": "iMessage platform adapter for @getloopscale/loopzero-gateway, driving imsg's JSON-RPC mode over stdio on a signed-in Mac.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loopzero-gateways.git",
    "directory": "packages/gateway-imessage"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@getloopscale/loopzero-gateway": ">=0.27.0 <1.0.0"
  },
  "devDependencies": {
    "@getloopscale/loopzero-gateway": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/getloopscale/loopzero-gateways/issues"
  },
  "homepage": "https://github.com/getloopscale/loopzero-gateways/tree/main/packages/gateway-imessage#readme",
  "keywords": [
    "loopzero",
    "gateway",
    "imessage",
    "imsg",
    "platform",
    "adapter"
  ]
}
